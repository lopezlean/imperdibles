---
import { AFFILIATE_LEGEND, CATEGORIES_LABEL, NOT_AFFILIATED, TRANSPARENCY_LINK } from "../../src/output/copy.js";
import { categoryPath } from "../lib/slugs.js";

export interface Props {
  pricesNote: string | null;
}
---

<footer class="wrap legal">
  <p class="sign" aria-hidden="true"><b>imperdibles</b><i>.com.ar</i></p>
  <div class="rule"></div>
  {
    (Astro.props.categories ?? []).length > 0 && (
      <nav aria-label={CATEGORIES_LABEL} class="nav">
        {(Astro.props.categories ?? []).map((c) => <a href={categoryPath(c.id)}>{c.name}</a>)}
      </nav>
    )
  }
  <div class="notes">
    <p>{AFFILIATE_LEGEND}</p>
    <p>{NOT_AFFILIATED}</p>
    <p><a href="/transparencia/">{TRANSPARENCY_LINK}</a></p>
    {Astro.props.pricesNote && <p>{Astro.props.pricesNote}</p>}
  </div>
</footer>
