---
import { CATEGORIES_LABEL, NAV } from "../../src/output/copy.js";
import { categoryPath } from "../lib/slugs.js";

export interface Props {
  categories?: { id: string; name: string }[];
}

const { categories = [] } = Astro.props;
---

<header class="hd">
  <div class="wrap hd-row">
    <div class="brand-row">
      <a href="/" class="brand"><b>imperdibles</b><i>.com.ar</i></a>
      <span class="monogram" aria-hidden="true">i</span>
    </div>
    <nav class="nav" aria-label="Principal">
      <a href="/">{NAV.hoy}</a>
      <a href="/#como">{NAV.como}</a>
      <a href="/cupones/">{NAV.cupones}</a>
      <a href="/#canal">{NAV.canal}</a>
    </nav>
  </div>
  {
    categories.length > 0 && (
      <div class="wrap">
        <nav class="nav" aria-label={CATEGORIES_LABEL}>
          {categories.map((c) => <a href={categoryPath(c.id)}>{c.name}</a>)}
        </nav>
      </div>
    )
  }
  <div class="wrap"><div class="rule"></div></div>
</header>
