---
import { FOLLOW_CATEGORY } from "../../../src/output/copy.js";
import ProductCard from "../../components/ProductCard.astro";
import Base from "../../layouts/Base.astro";
import { readSiteEnv } from "../../lib/env.js";
import { activeCategories, buildProducts, categoryProducts } from "../../lib/products.js";
import { absoluteUrl, breadcrumbLd, categoryDescription, categoryItemListLd, categoryTitle, ogImageOf } from "../../lib/seo.js";
import { channelUrlOf } from "../../lib/category-channels.js";
import { getCategoryChannels, getSiteData } from "../../lib/site-data.js";
import { categoryPath } from "../../lib/slugs.js";

export async function getStaticPaths() {
  const d = await getSiteData();
  return activeCategories(d).map((c) => ({ params: { id: c.id }, props: { id: c.id } }));
}

const { id } = Astro.props;
const d = await getSiteData();
const { siteUrl, channelUrl } = readSiteEnv(process.env);
const category = d.categories.find((c) => c.id === id)!;
const handle = (await getCategoryChannels())[id];
const items = categoryProducts(buildProducts(d), id);
const path = categoryPath(id);
---

<Base
  title={categoryTitle(category.name)}
  description={categoryDescription(category.name, items.length)}
  path={path}
  ogImage={ogImageOf(items.map((p) => p.latest))}
  jsonLd={[
    breadcrumbLd([
      { name: "Inicio", url: absoluteUrl(siteUrl, "/") },
      { name: category.name, url: absoluteUrl(siteUrl, path) },
    ]),
    categoryItemListLd(items, siteUrl),
  ]}
  threshold_pct={d.threshold_pct}
  channelUrl={channelUrl}
>
  <main class="wrap today">
    <div class="sel">
      <h1>Imperdibles de {category.name}</h1>
    </div>
    {handle && <p><a class="cta" href={channelUrlOf(handle)} rel="noopener" target="_blank">{FOLLOW_CATEGORY(category.name)}</a></p>}
    <div class="list">
      {items.map((product) => <ProductCard product={product} />)}
    </div>
  </main>
</Base>
