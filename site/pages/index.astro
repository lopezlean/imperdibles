---
import { COMPARED_CHIP, EMPTY_PAGE, EMPTY_PAGE_LEAD, PUBLISHED_CHIP, TODAY_HEADING } from "../../src/output/copy.js";
import { MONTH_NAMES, formatDateDots, formatDateLong } from "../../src/output/format.js";
import DealList from "../components/DealList.astro";
import HistoryNav from "../components/HistoryNav.astro";
import Base from "../layouts/Base.astro";
import { dayPage, listDays } from "../lib/deals.js";
import { readSiteEnv } from "../lib/env.js";
import {
  absoluteUrl,
  breadcrumbLd,
  buildDescription,
  homeTitle,
  itemListLd,
  ogImageOf,
  topPct,
} from "../lib/seo.js";
import { getSiteData } from "../lib/site-data.js";
import { weekdayName } from "../lib/slugs.js";

const d = await getSiteData();
const { siteUrl, channelUrl } = readSiteEnv(process.env);
const latest = listDays(d).at(-1);
const page = latest ? dayPage(d, latest) : null;
const items = page?.items ?? [];

const empty = !page || items.length === 0;
const title = empty
  ? "Ofertas en Mercado Libre más baratas que en otras tiendas | imperdibles"
  : homeTitle(topPct(items));
const description = empty
  ? "Todavía no hay imperdibles publicados. Comparamos precios de Mercado Libre con otras tiendas todos los días."
  : buildDescription({ count: items.length, topPct: topPct(items), names: items.slice(0, 3).map((i) => i.candidate.title) });
const heading = page && !empty ? `Los imperdibles del ${weekdayName(page.run_date)} ${formatDateLong(page.run_date)}` : TODAY_HEADING;
const categoryName = page ? d.categories.find((c) => c.id === page.categoryId)?.name : undefined;
const eyebrow = page ? [formatDateDots(page.run_date), categoryName].filter(Boolean).join(" / ") : "";
---

<Base
  title={title}
  description={description}
  path="/"
  ogImage={ogImageOf(items)}
  jsonLd={[breadcrumbLd([{ name: "Inicio", url: absoluteUrl(siteUrl, "/") }]), itemListLd(items)]}
  noindex={empty}
  threshold_pct={d.threshold_pct}
  channelUrl={channelUrl}
  pricesDate={page?.run_date ?? null}
>
  <main id="hoy" class="wrap today">
    <div class="sel">
      <h1>{heading}</h1>
      {page && <p class="meta mono">{eyebrow}</p>}
    </div>
    {
      page && (
        <div class="chips">
          <span class="chip">{COMPARED_CHIP(page.models_compared)}</span>
          <span class="chip">{PUBLISHED_CHIP(items.length)}</span>
        </div>
      )
    }
    {
      empty ? (
        <div class="empty">
          <p class="display zero" aria-hidden="true">0</p>
          <h2>{EMPTY_PAGE}</h2>
          <p>{EMPTY_PAGE_LEAD}</p>
        </div>
      ) : (
        <DealList items={items} />
      )
    }
    {page && <HistoryNav prev={page.prev} month={page.month} />}
  </main>
</Base>
